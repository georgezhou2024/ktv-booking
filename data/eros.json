  "content": {
    "member": "\n                <div class=\"card\">\n                    <h2>VALUE CARD 储值卡</h2>\n                    <div class=\"sub-text\">*储值卡可点套餐酒水</div>\n                    <div class=\"item\"><div class=\"name\">¥5,000卡<div class=\"sub-text\">送580档任意酒水两瓶</div></div><div class=\"price\">—</div></div>\n                    <div class=\"item\"><div class=\"name\">¥10,000卡<div class=\"sub-text\">送马爹利名士干邑白兰地1瓶 或 巴黎之花1瓶</div></div><div class=\"price\">—</div></div>\n                    <div class=\"item\"><div class=\"name\">¥30,000卡<div class=\"sub-text\">送马爹利XO干邑白兰地 或 美丽时光巴黎艺术年份香槟1瓶</div></div><div class=\"price\">—</div></div>\n                    <div class=\"item\"><div class=\"name\">¥50,000卡<div class=\"sub-text\">送马爹利XXO干邑白兰地1瓶</div></div><div class=\"price\">—</div></div>\n                    <div class=\"item\"><div class=\"name\">¥100,000卡<div class=\"sub-text\">送美丽时光巴黎艺术年份香槟4瓶</div></div><div class=\"price\">—</div></div>\n                    <div class=\"item\"><div class=\"name\">¥300,000卡<div class=\"sub-text\">送尚·马爹利至尊干邑白兰地1瓶</div></div><div class=\"price\">—</div></div>\n                    <div class=\"card-tip\">禁止向未成年人出售酒水</div>\n                </div>\n            ",
    "whitewine": "\n                <div class=\"card\">\n                    <h2>WHITE WINE 白葡萄酒</h2>\n                    <div class=\"item\"><div class=\"name\">莱叶雷司令干白葡萄酒 LENNÉ <span class=\"en-name\">Riesling Dry White Wine</span></div><div class=\"price\">¥580 /1瓶 - ¥1600 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">桃乐丝公牛血干白葡萄酒 <span class=\"en-name\">Torres Sangre de Toro White</span></div><div class=\"price\">¥580 /1瓶 - ¥1600 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">贺兰山特选干白葡萄酒 <span class=\"en-name\">Helan Mountain Premium Collection</span></div><div class=\"price\">¥580 /1瓶 - ¥1600 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">优尼特蝴蝶莫斯卡托甜低醇起泡白葡萄酒 <span class=\"en-name\">Riunite Butterfly Moscato</span></div><div class=\"price\">¥580 /1瓶 - ¥1600 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">莫兰阿里高特白葡萄酒 <span class=\"en-name\">Moillard Aligote Bourgone</span></div><div class=\"price\">¥1080 /1瓶 - ¥2980 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">虔途红带一号霞多丽白葡萄酒 <span class=\"en-name\">Church Road One Single Vineyard Merlot GB</span></div><div class=\"price\">¥2180 /1瓶 - ¥6380 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">乐霏酒庄夏莎蒙哈榭矿石园干白 村庄级单一园 <span class=\"en-name\">Domaine Leflaive Chassagne-Montrachet</span></div><div class=\"price\">¥6880 /瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">莫尔少特酒堡布里尼-蒙哈榭甘蔗田干白 Château <span class=\"en-name\">de Meursault Puligny-Montrachet</span></div><div class=\"price\">¥9880 /瓶</div></div>\n                </div>\n            ",
    "redwine": "\n                <div class=\"card\">\n                    <h2>RED WINE 红葡萄酒</h2>\n                    <div class=\"item\"><div class=\"name\">桃乐丝公牛血干红葡萄酒 <span class=\"en-name\">Torres Sangre de Toro</span></div><div class=\"price\">¥580 /1瓶 - ¥1600 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">约瑟世家梅洛干红葡萄酒 <span class=\"en-name\">SanJose De Apalta Merlot Dry Red Wine</span></div><div class=\"price\">¥580 /1瓶 - ¥1600 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">虔途红标珍藏梅洛赤霞珠红葡萄酒 <span class=\"en-name\">Church Road Grand Reserve</span></div><div class=\"price\">¥1080 /1瓶 - ¥2980 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">珍宝酒庄勃艮第黑皮诺精选干红 <span class=\"en-name\">Jean Bouchard Bourgogne Pinot Noir</span></div><div class=\"price\">¥1080 /1瓶 - ¥2980 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">虔途红字创印梅洛赤霞珠红葡萄酒 <span class=\"en-name\">Church Road Tom</span></div><div class=\"price\">¥3680 /1瓶 - ¥9880 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">勒桦酒庄勃艮第大区干红葡萄酒 <span class=\"en-name\">Domaine Leroy Bourgogne Rouge</span></div><div class=\"price\">¥9880 /瓶</div></div>\n                </div>\n            ",
    "champagne": "\n                <div class=\"card\">\n                    <h2>CHAMPAGNE 香槟</h2>\n                    <div class=\"item\"><div class=\"name\">巴黎之花香槟 <span class=\"en-name\">Perrier Jouet Grand Brut</span></div><div class=\"price\">¥1780 /1瓶 - ¥5280 /3瓶 - ¥8780 /5瓶 - ¥16880 /10瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">美丽时光·巴黎艺术年份香槟 <span class=\"en-name\">Perrier Jouet Belle Epoque Vintage</span></div><div class=\"price\">¥5880 /1瓶 - ¥16880 /3瓶 - ¥27680 /5瓶 - ¥53980 /10瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">巴黎之花·美丽时光香槟 <span class=\"en-name\">Perrier Jouet Belle Epoque Luminous</span></div><div class=\"price\">¥8880 /1瓶 - ¥25880 /3瓶 - ¥42980 /5瓶 - ¥84980 /10瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">巴黎之花·美丽时光白中白年份香槟 <span class=\"en-name\">Perrier Jouet Belle Epoque BDB</span></div><div class=\"price\">¥13880 /1瓶 - ¥39980 /3瓶 - ¥65680 /5瓶</div></div>\n                    <div class=\"card-tip\">以上套餐包含软饮2/4/6/8 · 禁止向未成年人出售酒水</div>\n                </div>\n            ",
    "cognac": "\n                <div class=\"card\">\n                    <h2>COGNAC 干邑</h2>\n                    <div class=\"item\"><div class=\"name\">马爹利名士干邑白兰地 700ml <span class=\"en-name\">Martell Noblige</span></div><div class=\"price\">¥1980 /1瓶 - ¥5880 /3瓶 - ¥9580 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">马爹利蓝带干邑白兰地 700ml <span class=\"en-name\">Martell Cordon Bleu</span></div><div class=\"price\">¥4680 /1瓶 - ¥13580 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">马爹利XO干邑白兰地 700ml <span class=\"en-name\">Martell XO</span></div><div class=\"price\">¥4980 /1瓶 - ¥13980 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">马爹利尚选XXO干邑白兰地 700ml <span class=\"en-name\">Martell XXO</span></div><div class=\"price\">¥9980 /1瓶 - ¥28800 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">马爹利蓝带干邑白兰地 1500ml <span class=\"en-name\">Martell Cordon Bleu</span></div><div class=\"price\">¥13880 /瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">马爹利高希霸 <span class=\"en-name\">Martell Cohiba</span></div><div class=\"price\">¥15880 /瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">马爹利XO干邑白兰地 3000ml <span class=\"en-name\">Martell XO</span></div><div class=\"price\">¥22880 /瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">尚·马爹利至尊干邑白兰地 700ml <span class=\"en-name\">L'OR de Jean Martell</span></div><div class=\"price\">¥51880 /瓶</div></div>\n                    <div class=\"card-tip\">以上套餐包含软饮2/4/6 · 禁止向未成年人出售酒水</div>\n                </div>\n            ",
