    "rooms": "\n                <style>\n                    .rl-floor{font-size:15px;color:#c9a96e;letter-spacing:3px;margin:18px 0 10px;padding-bottom:6px;border-bottom:1px solid rgba(201,169,110,0.25);}\n                    .rl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(95px,1fr));gap:8px;margin-bottom:6px;}\n                    .rl-btn{background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);border-radius:10px;padding:12px 6px;text-align:center;cursor:pointer;}\n                    .rl-btn:active{background:rgba(255,255,255,0.18);}\n                    .rl-num{display:block;font-size:14px;font-weight:600;color:#fff;letter-spacing:1px;}\n                    .rl-mic{width:20px;height:20px;margin-top:6px;opacity:0.6;}\n                    .rl-hint{font-size:9px;color:rgba(255,255,255,0.35);margin-top:3px;}\n                    .rd-back{display:inline-block;padding:8px 18px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);border-radius:8px;color:#fff;font-size:13px;cursor:pointer;margin-bottom:10px;}\n                    .rd-title{color:#c9a96e;font-size:18px;margin-bottom:10px;letter-spacing:2px;}\n                    .rd-photo{width:100%;border-radius:8px;cursor:pointer;display:block;}\n                </style>\n                <div id=\"rl-view\">\n                    <div class=\"rd-back\" onclick=\"backToCategories()\">&#8592; 返回分类</div>\n                    <div class=\"rl-floor\">5F</div>\n                    <div class=\"rl-grid\">\n                        <div class=\"rl-btn\" onclick=\"showRoom('rooms/individual/5f-phclub-010.jpg','PH CLUB-010')\"><span class=\"rl-num\">PH CLUB-010</span><img src=\"rooms/individual/mic-icon.png\" class=\"rl-mic\"><div class=\"rl-hint\">点击查看</div></div>\n                        <div class=\"rl-btn\" onclick=\"showRoom('rooms/individual/5f-eros-e.jpg','EROS E ROOM')\"><span class=\"rl-num\">EROS E ROOM</span><img src=\"rooms/individual/mic-icon.png\" class=\"rl-mic