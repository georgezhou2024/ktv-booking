    "member": "\n                <div class=\"card\">\n                    <h2>PH VALUE CARD 会员充值</h2>\n                    <div class=\"item\"><div class=\"name\">¥10,000卡<div class=\"sub-text\">赠 马爹利名士 1瓶 或 轩尼诗V.S.O.P 1瓶</div></div><div class=\"price\">—</div></div>\n                    <div class=\"item\"><div class=\"name\">¥30,000卡<div class=\"sub-text\">赠 马爹利X.O 1瓶 或 轩尼诗X.O 1瓶</div></div><div class=\"price\">—</div></div>\n                    <div class=\"item\"><div class=\"name\">¥50,000卡<div class=\"sub-text\">赠 马爹利X.X.O 1瓶 或 轩尼诗X.X.O 1瓶</div></div><div class=\"price\">—</div></div>\n                    <div class=\"item\"><div class=\"name\">¥100,000卡<div class=\"sub-text\">赠 巴黎之花美丽时光 4瓶 或 轩尼诗百乐廷 1瓶</div></div><div class=\"price\">—</div></div>\n                    <div class=\"item\"><div class=\"name\">¥300,000卡<div class=\"sub-text\">赠 路易十三 1瓶</div></div><div class=\"price\">—</div></div>\n                    <div class=\"item\"><div class=\"name\">¥500,000卡<div class=\"sub-text\">赠 ¥100,000 消费额度</div></div><div class=\"price\">—</div></div>\n                </div>\n            ",
    "whisky": "\n                <div class=\"card\">\n                    <h2>WHISKY</h2>\n                    <div class=\"item\"><div class=\"name\">奥克尼高原骑士12年 <span class=\"en-name\">Highland Park 12 YO</span></div><div class=\"price\">¥1200 /1瓶 - ¥3500 /3瓶 - ¥5680 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">格兰格拉索12年 <span class=\"en-name\">Glenglassaugh 12 YO</span></div><div class=\"price\">¥1780 /1瓶 - ¥5180 /3瓶 - ¥8580 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">麦卡伦12年单一麦芽 <span class=\"en-name\">Macallan 12 YO</span></div><div class=\"price\">¥1980 /1瓶 - ¥5880 /3瓶 - ¥9580 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">百富12年 <span class=\"en-name\">The Balvenie 12 YO</span></div><div class=\"price\">¥1980 /1瓶 - ¥5880 /3瓶 - ¥9580 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">格兰杰雪莉酒桶15年 <span class=\"en-name\">Glenmorangie Lasanta 15 yo</span></div><div class=\"price\">¥1980 /1瓶 - ¥5880 /3瓶 - ¥9580 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">格兰菲迪XS15年 <span class=\"en-name\">Glenfiddich XS 15 YO</span></div><div class=\"price\">¥1980 /1瓶 - ¥5880 /3瓶 - ¥9580 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">麦卡伦盈钻 <span class=\"en-name\">Macallan Litha</span></div><div class=\"price\">¥2880 /1瓶 - ¥8380 /3瓶 - ¥13880 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">格兰杰18年 <span class=\"en-name\">Glenmorangie 18 yo Thelnfinita</span></div><div class=\"price\">¥2880 /1瓶 - ¥8380 /3瓶 - ¥13880 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">格兰菲迪XS18年 <span class=\"en-name\">Glenfiddich XS 18 YO</span></div><div class=\"price\">¥2880 /1瓶 - ¥8380 /3瓶 - ¥13880 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">穿岩十九 单一糯米威士忌 <span class=\"en-name\">The CHUANYAN 19</span></div><div class=\"price\">¥3880 /1瓶 - ¥11200 /3瓶 - ¥18000 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">麦卡伦15年单一麦芽 <span class=\"en-name\">Macallan 15 YO</span></div><div class=\"price\">¥4980 /1瓶 - ¥13980 /3瓶 - ¥23880 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">格兰菲迪XS21年 <span class=\"en-name\">Glenfiddich XS 21 YO</span></div><div class=\"price\">¥4980 /1瓶 - ¥13980 /3瓶 - ¥23880 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">山崎12年 <span class=\"en-name\">Yamazaki 12 YO</span></div><div class=\"price\">¥5880 /1瓶 - ¥16880 /3瓶 - ¥24880 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">麦卡伦18年单一麦芽 <span class=\"en-name\">Macallan 18 YO</span></div><div class=\"price\">¥12800 /瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">麦卡伦25年 <span class=\"en-name\">Macallan 25 YO</span></div><div class=\"price\">¥39800 /瓶</div></div>\n                </div>\n            ",
    "tequila": "\n                <div class=\"card\">\n                    <h2>TEQUILA</h2>\n                    <div class=\"item\"><div class=\"name\">818陈酿龙舌兰 818 <span class=\"en-name\">Tequila Anejo</span></div><div class=\"price\">¥1580 /1瓶 - ¥4280 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">秘曜(银)龙舌兰 <span class=\"en-name\">Codigo Golden</span></div><div class=\"price\">¥1680 /1瓶 - ¥4980 /3瓶 - ¥8080 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">秘曜(粉)龙舌兰 <span class=\"en-name\">Codigo Rosa</span></div><div class=\"price\">¥1680 /1瓶 - ¥4980 /3瓶 - ¥8080 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">秘曜(金)龙舌兰 <span class=\"en-name\">Codigo Blanco</span></div><div class=\"price\">¥1980 /1瓶 - ¥5680 /3瓶 - ¥9680 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">唐胡里奥1942龙舌兰 <span class=\"en-name\">Don Julio 1942</span></div><div class=\"price\">¥5980 /1瓶 - ¥17800 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">克斯阿苏尔银色龙舌兰 <span class=\"en-name\">Clase Azul Tequila Plata</span></div><div class=\"price\">¥6880 /瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">克斯阿苏尔青花龙舌兰 <span class=\"en-name\">Clase Azul Tequila Reposado</span></div><div class=\"price\">¥6880 /瓶</div></div>\n                </div>\n            ",
    "cognac": "\n                <div class=\"card\">\n                    <h2>COGNAC</h2>\n                    <div class=\"item\"><div class=\"name\">马爹利名士 <span class=\"en-name\">Martell Noblige</span></div><div class=\"price\">¥1980 /1瓶 - ¥5880 /3瓶 - ¥9580 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">轩尼诗詹姆士 <span class=\"en-name\">James Hennessy</span></div><div class=\"price\">¥2880 /1瓶 - ¥8380 /3瓶 - ¥13880 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">马爹利蓝带 <span class=\"en-name\">Martell Cordon Bleu</span></div><div class=\"price\">¥4680 /1瓶 - ¥13580 /3瓶 - ¥22880 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">马爹利XO <span class=\"en-name\">Martell X.O</span></div><div class=\"price\">¥4980 /1瓶 - ¥13980 /3瓶 - ¥23880 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">轩尼诗XO <span class=\"en-name\">Hennessy X.O</span></div><div class=\"price\">¥4980 /1瓶 - ¥13980 /3瓶 - ¥23880 /5瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">轩尼诗XO <span class=\"en-name\">La Carafe Hennessy X.0 La Carafe</span></div><div class=\"price\">¥6880 /1瓶 - ¥19800 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">马爹利XXO <span class=\"en-name\">Martell X.X.O</span></div><div class=\"price\">¥9980 /1瓶 - ¥28800 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">轩尼诗XXO <span class=\"en-name\">Hennessy X.X.O</span></div><div class=\"price\">¥9980 /1瓶 - ¥28800 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">马爹利高希霸 <span class=\"en-name\">Martell Cohiba</span></div><div class=\"price\">¥15880 /瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">轩尼诗百乐廷 <span class=\"en-name\">Hennessy Paradis</span></div><div class=\"price\">¥22800 /瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">路易十三 <span class=\"en-name\">Louis XIII</span></div><div class=\"price\">¥51800 /瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">轩尼诗 李察 <span class=\"en-name\">Richard Hennessy</span></div><div class=\"price\">¥61800 /瓶</div></div>\n                </div>\n            ",
    "champagne": "\n                <div class=\"card\">\n                    <h2>CHAMPAGNE</h2>\n                    <div class=\"item\"><div class=\"name\">巴黎之花香槟 Perrier-Jouët <span class=\"en-name\">Champagne</span></div><div class=\"price\">¥1780 /1瓶 - ¥5280 /3瓶 - ¥16880 /10瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">酩悦香槟 <span class=\"en-name\">Moet & Chandon Champagne</span></div><div class=\"price\">¥1780 /1瓶 - ¥5280 /3瓶 - ¥16880 /10瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">唐培里侬香槟王夜光 Dom Pérignon <span class=\"en-name\">Champagne</span></div><div class=\"price\">¥5980 /1瓶 - ¥16800 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">唐培里侬香槟王粉红夜光 Dom Pérignon <span class=\"en-name\">Rose</span></div><div class=\"price\">¥9880 /1瓶 - ¥28800 /3瓶</div></div>\n                </div>\n            ",
    "whitewine": "\n                <div class=\"card\">\n                    <h2>WHITE WINE</h2>\n                    <div class=\"item\"><div class=\"name\">南澳湾马尔堡长相思 South Bay Marlborough Sauvignon Blanc<div class=\"sub-text\">新西兰 · 马尔堡</div></div><div class=\"price\">¥880 /1瓶 - ¥2500 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">逃牛岭初叙桃红 <span class=\"en-name\">Runaway Cow Whisper Rose</span></div><div class=\"price\">¥1000 /1瓶 - ¥2600 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">瑞恩酒园勃艮第夏布利白葡萄酒 Jean Marc Brocard Chablis Saint Claire<div class=\"sub-text\">法国 · 勃艮第</div></div><div class=\"price\">¥1500 /1瓶 - ¥4000 /3瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">薇薇酒庄夏布利藤蔓之花干白 Chateau de Viviers Chablis \"Fleur de Vigne\"<div class=\"sub-text\">法国 · 勃艮第</div></div><div class=\"price\">¥4500 /瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">宝尚酒园默尔索白葡萄酒 Bouchard Père & Fils Meursault Blanc<div class=\"sub-text\">法国 · 勃艮第</div></div><div class=\"price\">¥6666 /瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">宝尚酒园夏山-蒙哈榭白葡萄酒 Bouchard Père & Fils Chassagne-Montrachet Blanc<div class=\"sub-text\">法国 · 勃艮第</div></div><div class=\"price\">¥9999 /瓶</div></div>\n                </div>\n            ",
    "redwine": "\n                <div class=\"card\">\n                    <h2>RED WINE</h2>\n                    <div class=\"item\"><div class=\"name\">雷格隐士酒庄干红 Chateau L'Hermitage Lescours<div class=\"sub-text\">法国 · 圣爱美隆特级</div></div><div class=\"price\">¥2800 /瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">堡歌家族德瑞考特巴罗萨赤霞珠 Burge Family Winemakers Draycott Cabernet Sauvignon<div class=\"sub-text\">澳大利亚 · 巴罗莎谷</div></div><div class=\"price\">¥3500 /瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">宝尚酒园哲维瑞-香贝丹红葡萄酒 <span class=\"en-name\">Bouchard Pere & Fils Gevrey-Chambertin</span></div><div class=\"price\">¥8000 /瓶</div></div>\n                </div>\n            ",
    "vodka": "\n                <div class=\"card\">\n                    <h2>VODKA</h2>\n                    <div class=\"item\"><div class=\"name\">雪树伏特加 <span class=\"en-name\">Belvedere Vodka</span></div><div class=\"price\">¥1200 /瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">灰雁伏特加 <span class=\"en-name\">Grey Goose Vodka</span></div><div class=\"price\">¥1380 /瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">绝对亦乐伏特加 <span class=\"en-name\">Absolut Elyx</span></div><div class=\"price\">¥1380 /瓶</div></div>\n                </div>\n            ",
    "beer": "\n                <div class=\"card\">\n                    <h2>BEER</h2>\n                    <div class=\"item\"><div class=\"name\">喜力铝罐啤酒 <span class=\"en-name\">Heineken</span></div><div class=\"price\">¥60 /瓶</div></div>\n                </div>\n            ",
    "softdrink": "\n                <div class=\"card\">\n                    <h2>SOFT DRINK</h2>\n                    <div class=\"item\"><div class=\"name\">可乐 (德国) <span class=\"en-name\">Cola</span></div><div class=\"price\">¥50 /瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">无糖可乐 (德国) <span class=\"en-name\">Cola Zero</span></div><div class=\"price\">¥50 /瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">无糖雪碧 (北海道) <span class=\"en-name\">Sprite Zero</span></div><div class=\"price\">¥50 /瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">芙丝苏打水 (挪威) <span class=\"en-name\">Voss Soda</span></div><div class=\"price\">¥50 /瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">芙丝水 (挪威) <span class=\"en-name\">Voss</span></div><div class=\"price\">¥50 /瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">胜狮气泡水 (泰国) <span class=\"en-name\">Singha Soda</span></div><div class=\"price\">¥50 /瓶</div></div>\n                    <div class=\"item\"><div class=\"name\">if椰子水 (泰国) <span class=\"en-name\">if</span></div><div class=\"price\">¥50 /瓶</div></div>\n                </div>\n            ",
    "shisha": "\n                <style>\n                    .sh-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px;}\n                    .sh-btn{background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);border-radius:10px;padding:16px 8px;text-align:center;cursor:pointer;}\n                    .sh-btn:active{background:rgba(255,255,255,0.18);}\n                    .sh-btn .t{display:block;font-size:14px;font-weight:600;color:#fff;}\n                    .sh-btn .p{display:block;font-size:12px;color:rgba(255,255,255,0.5);margin-top:4px;}\n                    .sh-back{display:inline-block;padding:8px 18px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);border-radius:8px;color:#fff;font-size:13px;cursor:pointer;margin-bottom:10px;}\n                    .sh-cols{display:grid;grid-template-columns:1fr 1fr;gap:4px 20px;}\n                    .sh-cols .item{padding:8px 0;}\n                </style>\n                <div id=\"sh-list\">\n                    <div class=\"sh-back\" onclick=\"backToCategories()\">&#8592; 返回分类</div>\n                    <div class=\"sh-grid\">\n                        <div class=\"sh-btn\" onclick=\"showShisha('fruit')\"><span class=\"t\">水果特调</span><span class=\"p\">¥368</span></div>\n                        <div class=\"sh-btn\" onclick=\"showShisha('herbal')\"><span class=\"t\">草本特调</span><span class=\"p\">¥368</span></div>\n                        <div class=\"sh-btn\" onclick=\"showShisha('flowers')\"><span class=\"t\">花香特调</span><span class=\"p\">¥368</span></div>\n                        <div class=\"sh-btn\" onclick=\"showShisha('s428')\"><span class=\"t\">¥428系列</span><span class=\"p\">8款</span></div>\n                        <div class=\"sh-btn\" onclick=\"showShisha('deus')\"><span class=\"t\">Deus Perfume</span><span class=\"p\">¥488 · 4款</span></div>\n                        <div class=\"sh-btn\" onclick=\"showShisha('bonche')\"><span class=\"t\">Bonche</span><span class=\"p\">¥488 · 12款</span></div>\n                        <div class=\"sh-btn\" onclick=\"showShisha('trofi')\"><span class=\"t\">Trofimoff's</span><span class=\"p\">¥488 · 5款</span></div>\n                        <div class=\"sh-btn\" onclick=\"showShisha('special')\"><span class=\"t\">Special Blend</span><span class=\"p\">¥688 · 3款</span></div>\n                        <div class=\"sh-btn\" onclick=\"showShisha('custom')\"><span class=\"t\">定制版</span><span class=\"p\">¥888</span></div>\n                        <div class=\"sh-btn\" onclick=\"showShisha('maklaud')\"><span class=\"t\">Maklaud西游记</span><span class=\"p\">¥9981</span></div>\n                        <div class=\"sh-btn\" onclick=\"showShisha('base')\"><span class=\"t\">壶底选择</span><span class=\"p\">+¥58起</span></div>\n                    </div>\n                </div>\n                <div id=\"sh-detail\" style=\"display:none;\">\n                    <div class=\"sh-back\" onclick=\"backToShisha()\">&#8592; 返回水烟目录</div>\n                    <div id=\"sh-content\"></div>\n                </div>\n            ",
    "notice": "\n                <div class=\"card\">\n                    <h2>酒水寄存须知 Liquor Storage Notice</h2>\n                    <div class=\"notice-block\">\n                        <p>1. 免费存酒有效期 30 天,到期前可续存,将短信提醒。<br>Complimentary liquor storage is valid for 30 days. Renewal is available before expiry, and a text message reminder will be sent.</p>\n                        <br>\n                        <p>2. 逾期未续存 / 取酒,视为放弃保管,本店不再留存。<br>Failure to renew or retrieve stored liquor by the deadline will be deemed as forfeiture of storage, and the establishment will no longer retain the items.</p>\n                        <br>\n                        <p>3. 寄存即同意本规则。<br>Storing liquor constitutes agreement to these terms.</p>\n                    </div>\n                </div>\n            "
  }
